#=============================================================================#

CONFIG_USB_ETH=n
CONFIG_USB_ETH_RNDIS=n
CONFIG_USB_GADGETFS=n
CONFIG_USB_G_SERIAL=n
CONFIG_USB_G_MULTI=n
CONFIG_USB_G_CDC=n
CONFIG_USB_G_ETHER=n
CONFIG_USB_G_PRINTER=n
CONFIG_USB_G_WEBCAM=n

CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y

CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_LIBCOMPOSITE=y

CONFIG_USB_DWC2_PERIPHERAL=y

#=============================================================================#

# Audio support - WM8960 codec and I2S
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_I2C_AND_SPI=y
CONFIG_SND_DMAENGINE_PCM=y
CONFIG_SND_SOC_STM32_I2S=y
CONFIG_SND_SOC_WM8960=y

# PMIC onkey as input event
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_STPMIC1=y
CONFIG_SND_SIMPLE_CARD=y

#=============================================================================#

# TUN/TAP - required for kaonic-vpn tunnel interfaces
CONFIG_TUN=m

# Netfilter - required for iptables MASQUERADE (VPN route aliasing NAT)
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NFT_MASQ=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m

CONFIG_BRCMDBG=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BT=m
CONFIG_BT_BCM=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_SERIAL_DEV_BUS=y

CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_STM32=y
CONFIG_SPI_SPIDEV=y

CONFIG_GPIO_PCA953X=y

CONFIG_MEMORY=y
CONFIG_STM32_FMC2_EBI=y
CONFIG_MTD=y
CONFIG_MTD_RAM=y
CONFIG_MTD_BLOCK=y

# FPGA on FMC bank 2 is mapped from userspace through /dev/mem (kaonic-radio).
# STRICT_DEVMEM would still permit the IO window, but IO_STRICT_DEVMEM refuses
# any region claimed by a driver - keep both off so the mapping cannot break
# depending on what binds to the FMC child node.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set

#=============================================================================#

# Hardware CRC (STM32 CRC1) exposed to userspace via AF_ALG (kaonic-crc)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_STM32_CRC=y
# Generic crc32 so AF_ALG bind still works if the peripheral driver is absent
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y

#=============================================================================#

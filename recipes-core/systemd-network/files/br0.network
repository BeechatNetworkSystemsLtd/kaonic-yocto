[Match]
Name=br0

[Network]
ConfigureWithoutCarrier=yes
Address=192.168.10.1/24
DHCPServer=yes
# Uncomment to share an upstream internet connection. Note that systemd does
# not accept trailing comments on a setting line: the text becomes part of the
# value and the whole assignment is rejected.
#IPMasquerade=ipv4

[DHCPServer]
PoolOffset=10
PoolSize=100
# The board is not a gateway by default (IPMasquerade is off above) and its
# dnsmasq has no upstream, so a client told to route through it loses the
# internet it had over its own WiFi or Ethernet. Clients still reach the board
# at 192.168.10.1 over the on-link route, which is all the USB link is for.
#
# The gateway turns DHCP over to dnsmasq when it has an upstream to share
# ("push routes"), and that path advertises a router and resolver itself, so
# internet sharing is unaffected by these being off here.
EmitRouter=no
EmitDNS=no

&i2c1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c1_pins_mx>;
	pinctrl-1 = <&i2c1_sleep_pins_mx>;
	status = "okay";

	/* USER CODE BEGIN i2c1 */
	gpio_exp1: gpio@20 {
		compatible = "ti,tca6408";
		reg = <0x20>;

		#gpio-cells = <2>;
		gpio-controller;
		status = "okay";
	};


	wm8960: codec@1a {
		compatible = "wlf,wm8960";
		reg = <0x1a>;
		#sound-dai-cells = <0>;
		clocks = <&wm8960_mclk>;
		clock-names = "mclk";
		/* ADCLRC/GPIO1 and DACLRC are tied together on the adapter */
		wlf,shared-lrclk;
		wlf,gpio-cfg = <1 0>;
		AVDD-supply = <&v3v3>;
		DCVDD-supply = <&v3v3>;
		DBVDD-supply = <&v3v3>;
		/* SPKVDD1/SPKVDD2 are fed from the +5V rail of the Kaonic connector */
		SPKVDD1-supply = <&vin>;
		SPKVDD2-supply = <&vin>;

		port {
			wm8960_endpoint: endpoint {
				remote-endpoint = <&i2s2_endpoint>;
			};
		};
	};
	/* USER CODE END i2c1 */
};

&i2c2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c2_pins_mx>;
	pinctrl-1 = <&i2c2_sleep_pins_mx>;
	status = "okay";

	/* USER CODE BEGIN i2c2 */

	gpio_exp0: gpio@21 {
		compatible = "ti,tca9539";
		reg = <0x21>;

		#gpio-cells = <2>;
		gpio-controller;
		status = "okay";
	};

	/* USER CODE END i2c2 */
};

&i2s2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2s2_pins_mx>;
	pinctrl-1 = <&i2s2_sleep_pins_mx>;
	status = "okay";

	/* USER CODE BEGIN i2s2 */
	clocks = <&rcc SPI2>, <&rcc SPI2_K>, <&rcc PLL3_Q>, <&rcc PLL3_R>;
	clock-names = "pclk", "i2sclk", "x8k", "x11k";

	i2s2_port: port {
		i2s2_endpoint: endpoint {
			remote-endpoint = <&wm8960_endpoint>;
			format = "i2s";
			mclk-fs = <256>;
		};
	};

	/* USER CODE END i2s2 */
};


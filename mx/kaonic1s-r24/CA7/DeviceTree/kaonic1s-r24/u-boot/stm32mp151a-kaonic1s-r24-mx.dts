&fmc {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&fmc_pins_mx>;
	pinctrl-1 = <&fmc_sleep_pins_mx>;
	status = "okay";

	/* USER CODE BEGIN fmc */
	/* Override the CubeMX pin groups: FMC_A17 (PD12) is required to reach
	 * the FPGA DATA port and is not part of fmc_pins_mx.
	 */
	pinctrl-0 = <&fmc_fpga_pins_mx>;
	pinctrl-1 = <&fmc_fpga_sleep_pins_mx>;

	#address-cells = <2>;
	#size-cells = <1>;

	fpga@1,0 {
		compatible = "beechat,kaonic1s-fpga";
		reg = <1 0x00000000 0x00040000>;
		bank-width = <1>;

		st,fmc2-ebi-cs-transaction-type = <1>; /* async mode 1, PSRAM */
		st,fmc2-ebi-cs-address-setup-ns = <30>;
		st,fmc2-ebi-cs-data-setup-ns = <40>;
		st,fmc2-ebi-cs-bus-turnaround-ns = <15>;
	};
	/* USER CODE END fmc */
};


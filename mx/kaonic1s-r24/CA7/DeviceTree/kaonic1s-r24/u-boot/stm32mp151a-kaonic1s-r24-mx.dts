	pinctrl-1 = <&usart1_idle_pins_mx>;
	pinctrl-2 = <&usart1_sleep_pins_mx>;
	status = "okay";

	/* USER CODE BEGIN usart1 */
	uart-has-rtscts;

	bluetooth {
		shutdown-gpios = <&gpioa 3 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpioe 1 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "host-wakeup";
		compatible = "brcm,bcm43438-bt";
		vbat-supply = <&v3v3>;
		vddio-supply = <&v3v3>;
	};

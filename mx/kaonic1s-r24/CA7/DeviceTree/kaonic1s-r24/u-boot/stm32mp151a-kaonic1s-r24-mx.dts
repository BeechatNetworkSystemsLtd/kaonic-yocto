};

&usbphyc_port0 {
	status = "okay";

	/* USER CODE BEGIN usbphyc_port0 */
	st,tune-hs-dc-level = <2>;
	st,enable-fs-rftime-tuning;
	st,enable-hs-rftime-reduction;
	st,trim-hs-current = <15>;
	st,trim-hs-impedance = <1>;
	st,tune-squelch-level = <3>;
	st,tune-hs-rx-offset = <2>;
	st,no-lsfs-sc;

	st,phy-tuning = <&usb_phy_tuning>;

	phy-supply = <&vdd_usb>;
    vbus-supply = <&vbus_sw>;

	connector {
		compatible = "usb-a-connector";
		vbus-supply = <&vbus_sw>;
	};
	/* USER CODE END usbphyc_port0 */
};

&usbphyc_port1 {
	status = "okay";

	/* USER CODE BEGIN usbphyc_port1 */
    phy-supply = <&vdd_usb>;
	st,tune-hs-dc-level = <2>;
	st,enable-fs-rftime-tuning;
	st,enable-hs-rftime-reduction;
	st,trim-hs-current = <15>;
	st,trim-hs-impedance = <1>;
	st,tune-squelch-level = <3>;
	st,tune-hs-rx-offset = <2>;
	st,no-lsfs-sc;
	/* USER CODE END usbphyc_port1 */
};

/* USER CODE BEGIN addons */

&cpu0 {
	clocks = <&scmi_clk CK_SCMI_MPU>;
	cpu-supply = <&vddcore>;
};

/*
 * RCC is secure (see the OP-TEE device tree), so the normal world cannot enable
 * these banks itself and must take each one over SCMI. Missing entries show up
 * as pinctrl_select_state_full ... err=-19 and peripherals that never probe.
 */
&gpioa {
	clocks = <&scmi_clk CK_SCMI_GPIOA>;
};

&gpiob {
	clocks = <&scmi_clk CK_SCMI_GPIOB>;
};

&gpioc {
	clocks = <&scmi_clk CK_SCMI_GPIOC>;
};

&gpiod {
	clocks = <&scmi_clk CK_SCMI_GPIOD>;
};

&gpioe {
	clocks = <&scmi_clk CK_SCMI_GPIOE>;
};

&gpiof {
	clocks = <&scmi_clk CK_SCMI_GPIOF>;
};

&gpiog {
	clocks = <&scmi_clk CK_SCMI_GPIOG>;
};

&gpioh {
	clocks = <&scmi_clk CK_SCMI_GPIOH>;
};

&gpioi {
	clocks = <&scmi_clk CK_SCMI_GPIOI>;
};

&gpioj {
	clocks = <&scmi_clk CK_SCMI_GPIOJ>;
};

&gpiok {
	clocks = <&scmi_clk CK_SCMI_GPIOK>;
};

&gpioz {
	clocks = <&scmi_clk CK_SCMI_GPIOZ>;
};

&hash1 {
	clocks = <&scmi_clk CK_SCMI_HASH1>;
	resets = <&scmi_reset RST_SCMI_HASH1>;
};

&i2c4 {
	clocks = <&scmi_clk CK_SCMI_I2C4>;
	resets = <&scmi_reset RST_SCMI_I2C4>;
};

/*
 * I2C4 is secure (DECPROT_S_RW), so the PMIC belongs to OP-TEE and there is no
 * stpmic node in this device tree to define the regulator labels. Linux reaches
 * the same rails through SCMI voltage domains instead; the labels below are what
 * the consumers in this file (&v3v3, &vdd_usb, &vbus_sw, &vdd, &vddcore) bind to.
 * Rail assignment matches the PMIC node in the OP-TEE device tree.
 */
&scmi {
	scmi_voltd: protocol@17 {
		reg = <0x17>;

		scmi_regu: regulators {
			#address-cells = <1>;
			#size-cells = <0>;

			vddcore: regulator@3 {
				reg = <VOLTD_SCMI_STPMIC1_BUCK1>;
				regulator-name = "vddcore";
			};

			vdd: regulator@5 {
				reg = <VOLTD_SCMI_STPMIC1_BUCK3>;
				regulator-name = "vdd";
			};

			v3v3: regulator@6 {
				reg = <VOLTD_SCMI_STPMIC1_BUCK4>;
				regulator-name = "v3v3";
			};

			vdd_usb: regulator@a {
				reg = <VOLTD_SCMI_STPMIC1_LDO4>;
				regulator-name = "vdd_usb";
			};

			vbus_sw: regulator@10 {
				reg = <VOLTD_SCMI_STPMIC1_PWR_SW2>;
				regulator-name = "vbus_sw";
			};
		};
	};
};

&i2c6 {
	clocks = <&scmi_clk CK_SCMI_I2C6>;
	resets = <&scmi_reset RST_SCMI_I2C6>;
};

&iwdg2 {
	clocks = <&rcc IWDG2>, <&scmi_clk CK_SCMI_LSI>;
};

&m4_rproc {
	resets = <&scmi_reset RST_SCMI_MCU>,
		 <&scmi_reset RST_SCMI_MCU_HOLD_BOOT>;
	reset-names = "mcu_rst", "hold_boot";
	/delete-property/ st,syscfg-holdboot;
};

&mdma1 {
	resets = <&scmi_reset RST_SCMI_MDMA>;
};

&mlahb {
	resets = <&scmi_reset RST_SCMI_MCU>;
};

&rcc {
	compatible = "st,stm32mp1-rcc-secure", "syscon";
	clock-names = "hse", "hsi", "csi", "lse", "lsi";
	clocks = <&scmi_clk CK_SCMI_HSE>,
		 <&scmi_clk CK_SCMI_HSI>,
		 <&scmi_clk CK_SCMI_CSI>,
		 <&scmi_clk CK_SCMI_LSE>,
		 <&scmi_clk CK_SCMI_LSI>;
};

&rng1 {
	clocks = <&scmi_clk CK_SCMI_RNG1>;
	resets = <&scmi_reset RST_SCMI_RNG1>;
};

&rtc {
	clocks = <&scmi_clk CK_SCMI_RTCAPB>, <&scmi_clk CK_SCMI_RTC>;
};

&spi6 {
	clocks = <&scmi_clk CK_SCMI_SPI6>;
	resets = <&scmi_reset RST_SCMI_SPI6>;
};

&usart1 {
	clocks = <&scmi_clk CK_SCMI_USART1>;
};

/* USER CODE END addons */


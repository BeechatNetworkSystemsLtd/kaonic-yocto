	/* USER CODE BEGIN spi3 */

	cs-gpios= <&gpiob 13 0>;

	spidev0: spidev0@0 {
		compatible = "rohm,dh2228fv";
        reg = <0>;
        spi-max-frequency = <64000000>;
        status = "okay";
    };

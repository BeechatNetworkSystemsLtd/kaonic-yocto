/dts-v1/;

#include <dt-bindings/pinctrl/stm32-pinfunc.h>
#include "stm32mp151.dtsi"
#include "stm32mp15xa.dtsi"
#include "stm32mp15xxab-pinctrl.dtsi"
#include "stm32mp15-m4-srm.dtsi"
#include "stm32mp15-scmi.dtsi"

/* USER CODE BEGIN includes */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/mfd/st,stpmic1.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/regulator/st,stm32mp15-regulator.h>

/* USER CODE END includes */

/ {
	model = "STMicroelectronics custom STM32CubeMX board - openstlinux-6.6-yocto-scarthgap-mpu-v26.06.10";
	compatible = "st,stm32mp151a-kaonic1s-r24-mx", "st,stm32mp151";

	memory@c0000000 {
		device_type = "memory";
		reg = <0xc0000000 0x20000000>;

		/* USER CODE BEGIN memory */
		/* USER CODE END memory */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* USER CODE BEGIN reserved-memory */
		mcuram2:mcuram2@10000000{
			compatible = "shared-dma-pool";
			reg = <0x10000000 0x40000>;
			no-map;
		};

		mcuram:mcuram@30000000{
			compatible = "shared-dma-pool";
			reg = <0x30000000 0x40000>;
			no-map;
		};

		retram:retram@38000000{
			compatible = "shared-dma-pool";
			reg = <0x38000000 0x10000>;
			no-map; };

		optee@de000000 {
			reg = <0xde000000 0x2000000>;
			no-map;
		};

		gpu_reserved: gpu@d4000000 {
			reg = <0xd4000000 0x4000000>;
			no-map;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x8000000>;
			alignment = <0x2000>;
			linux,cma-default;
		};


		/* USER CODE END reserved-memory */
	};

	/* USER CODE BEGIN root */

	aliases {
		serial0 = &usart6;
		serial1 = &usart2;
		serial2 = &usart1;
		spi4 = &spi4;
		spi6 = &spi6;
		spi3 = &spi3;
		spi0 = &qspi;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
	};

	vin: vin {
		compatible = "regulator-fixed";
		regulator-name = "vin";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	vrf_3v3: vrf-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VRF 3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
		gpio = <&gpio_exp0 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vrf_pa: vrf-pa {
		compatible = "regulator-fixed";
		regulator-name = "VRF PA";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
		gpio = <&gpio_exp0 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpiog 7 GPIO_ACTIVE_LOW>;
	};

	usb_phy_tuning: usb-phy-tuning {
		st,hs-dc-level = <2>;
		st,fs-rftime-tuning;
		st,hs-rftime-reduction;
		st,hs-current-trim = <15>;
		st,hs-impedance-trim = <1>;
		st,squelch-level = <3>;
		st,hs-rx-offset = <2>;
		st,no-lsfs-sc;
	};

	wm8960_mclk: wm8960-mclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	sound {

		compatible = "simple-audio-card";
		simple-audio-card,name = "Kaonic WM8960 Audio";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&cpu_dai>;
		simple-audio-card,frame-master = <&cpu_dai>;
		status = "okay";

		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Speaker", "Ext Spk";
		simple-audio-card,routing =
			"Mic Jack", "MICB",
			"LINPUT2", "Mic Jack",
			"Ext Spk", "SPK_LP",
			"Ext Spk", "SPK_LN";
		cpu_dai: simple-audio-card,cpu {
			sound-dai = <&i2s2>;
		};
		codec_dai: simple-audio-card,codec {
			sound-dai = <&wm8960>;
			system-clock-frequency = <24000000>;
		};

	};

	/* USER CODE END root */

	clocks{

		/* USER CODE BEGIN clocks */
		/* USER CODE END clocks */
	};

}; /*root*/

&pinctrl {

	fmc_pins_mx: fmc_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('D', 0, AF12)>, /* FMC_DA2 */
					 <STM32_PINMUX('D', 1, AF12)>, /* FMC_DA3 */
					 <STM32_PINMUX('D', 4, AF12)>, /* FMC_NOE */
					 <STM32_PINMUX('D', 5, AF12)>, /* FMC_NWE */
					 <STM32_PINMUX('D', 14, AF12)>, /* FMC_DA0 */
					 <STM32_PINMUX('D', 15, AF12)>, /* FMC_DA1 */
					 <STM32_PINMUX('E', 7, AF12)>, /* FMC_DA4 */
					 <STM32_PINMUX('E', 8, AF12)>, /* FMC_DA5 */
					 <STM32_PINMUX('E', 9, AF12)>, /* FMC_DA6 */
					 <STM32_PINMUX('E', 10, AF12)>; /* FMC_DA7 */
			bias-disable;
			drive-push-pull;
			slew-rate = <1>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('G', 9, AF12)>; /* FMC_NE2 */
		};
	};

	fmc_sleep_pins_mx: fmc_sleep_mx-0 {
